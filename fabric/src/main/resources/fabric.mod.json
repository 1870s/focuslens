{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/1870s/focuslens",
    "issues": "https://github.com/1870s/focuslens/issues"
  },
  "license": "${license}",
  "icon": "assets/focuslens/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.focuslens.fabric.FocusLensFabric"
    ],
    "modmenu": [
      "dev.focuslens.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_dependency}",
    "java": ">=${java_version}"
  },
  "conflicts": {
    "optifabric": "*"
  }
}
